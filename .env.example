# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3100
HOST=127.0.0.1
DATABASE_URL=postgres://apskaita:CHANGE_ME@127.0.0.1:5432/apskaita
POSTGRES_PASSWORD=CHANGE_ME
# At least 32 random characters (e.g. `openssl rand -hex 32`). Used for session-bound download links and to encrypt store API keys.
APP_SECRET_KEY=
# Private file storage (originals, previews). Must not be web-served. Back it up together with the database.
STORAGE_DIR=/var/lib/apskaita/storage
# Cookies with the Secure flag (requires HTTPS; default true in production).
SECURE_COOKIES=true
# Optional direct HTTPS (otherwise use a TLS reverse proxy).
TLS_CERT=
TLS_KEY=
MAX_UPLOAD_MB=25
SESSION_HOURS=12
# Run background jobs in the web process (true) or separately with `npm run worker` (false).
WORKER_IN_PROCESS=true
OCR_LANGUAGES=lit+eng
# Optional ClamAV scanner binary, e.g. /usr/bin/clamscan
CLAMSCAN_PATH=
# Optional language-model line classification (disabled by default). See docs/SECURITY.md for data sent.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
