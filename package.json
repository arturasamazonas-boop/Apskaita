{
  "name": "apskaita",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paprasta apskaitos programa Lietuvos smulkiam verslui ir internetinėms parduotuvėms.",
  "scripts": {
    "start": "node src/server.mjs",
    "worker": "node src/worker.mjs",
    "migrate": "node src/cli.mjs migrate",
    "create-admin": "node src/cli.mjs create-admin",
    "demo:seed": "node src/cli.mjs demo-seed",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "perf": "node scripts/perf.mjs",
    "backup": "sh scripts/backup.sh",
    "restore": "sh scripts/restore.sh",
    "test:browser": "node test-browser/ui-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
